# Public
NEXT_PUBLIC_SITE_URL=https://tapcordengineering.com
# Optional - set to enable GA4 analytics, leave blank to disable
NEXT_PUBLIC_GA_ID=

# Supabase - server-only service-role client (contact form + upload notification route)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=plan-uploads
SUPABASE_CLIENT_PLANS_BUCKET=client-plans

# Supabase - public, used by the browser client, the session-aware server client,
# and middleware.ts for Auth (login, upload, dashboard). Required for /login,
# /upload and /dashboard to work - the rest of the site works without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_NOTIFICATION_EMAIL=tapcordengineering@gmail.com
